# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Strapi. Vacío = el sitio usa los datos de respaldo incluidos en el código.
# CMS_URL: dirección que usa el servidor de Next para leer el CMS (en Docker: http://cms:1337)
CMS_URL=
# CMS_PUBLIC_URL: dirección pública del CMS (imágenes y medios). Se lee también en el build.
CMS_PUBLIC_URL=
# Token de solo lectura creado en Strapi (Settings > API Tokens). Nunca se expone al navegador.
CMS_TOKEN=

# Secretos compartidos con Strapi (genera valores largos y aleatorios)
REVALIDATE_SECRET=
PREVIEW_SECRET=

# Solo desarrollo: muestra artículos de ejemplo cuando no hay CMS (true/false)
DEMO_CONTENT=false

# Google Analytics 4 (opcional). El ID es público; se inyecta en el build.
# Si queda vacío, no se carga GA4.
# Medida temporal: la etiqueta se carga directamente, sin aviso de consentimiento.
NEXT_PUBLIC_GA_ID=G-M37SMVCR2B
