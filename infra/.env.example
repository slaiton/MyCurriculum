# ============================================================
# Variables de producción. Copia a infra/.env (NUNCA lo subas a git).
# Genera cada secreto con: openssl rand -base64 32
# ============================================================

# --- Dominios ---
SITE_URL=https://www.slaiton.com
SITE_DOMAIN=www.slaiton.com
CMS_PUBLIC_URL=https://cms.slaiton.com
CMS_DOMAIN=cms.slaiton.com
# Puertos locales donde escuchan web y cms (solo 127.0.0.1)
WEB_PORT=3000
CMS_PORT=1337

# --- PostgreSQL ---
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# --- Strapi (secretos) ---
APP_KEYS=clave1,clave2,clave3,clave4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Integración sitio <-> CMS ---
# Token "Read-only" creado en Strapi: Settings > API Tokens (se completa tras el primer arranque)
CMS_TOKEN=
REVALIDATE_SECRET=
PREVIEW_SECRET=

# --- Opcional ---
# Google Analytics 4 (ID público). Solo se activa si el visitante acepta.
NEXT_PUBLIC_GA_ID=G-M37SMVCR2B

# --- Redacción asistida con IA (opcional) ---
# Basta con una de las dos. El modelo se elige en el panel (Guía editorial -> model).
# Anthropic (console.anthropic.com): modelos claude-*. Configura un límite de gasto mensual.
ANTHROPIC_API_KEY=
# DeepSeek (platform.deepseek.com): modelos deepseek-*. Funciona con saldo prepagado.
DEEPSEEK_API_KEY=
