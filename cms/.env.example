# --- Servidor ---
HOST=0.0.0.0
PORT=1337
# URL pública del panel/API (p. ej. https://cms.slaiton.com). Vacío en local.
PUBLIC_URL=
# true cuando corre detrás de Nginx/Caddy con HTTPS
IS_PROXIED=false
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:1337,http://localhost:3100

# --- Secretos (genera cada uno con: openssl rand -base64 32) ---
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Base de datos ---
# Local: sqlite. Producción: postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false

# --- Integración con el sitio (Next.js) ---
# URL del sitio para la vista previa (vacío = vista previa desactivada)
CLIENT_URL=http://localhost:3100
# Mismo valor que PREVIEW_SECRET en web/.env
PREVIEW_SECRET=
