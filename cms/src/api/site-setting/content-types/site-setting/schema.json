{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Ajustes del sitio",
    "description": "Datos personales, contacto, CV y SEO por defecto"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text",
      "required": true
    },
    "careerStartDate": {
      "type": "date",
      "required": true
    },
    "whatsapp": {
      "type": "string",
      "required": true,
      "regex": "^\\+?[0-9 ]{8,20}$"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "linkedinUrl": {
      "type": "string"
    },
    "githubUrl": {
      "type": "string"
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "heroVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  },
  "pluginOptions": {}
}
